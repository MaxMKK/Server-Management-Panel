# ==========================================
# ไฟล์แม่แบบตัวแปรสภาพแวดล้อม (Environment Variables)
# ==========================================
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกข้อมูลจริงของเครื่องคุณ

# ── การตั้งค่าระบบแอปพลิเคชัน ─────────────────────
NODE_ENV=development
APP_PORT=4000
APP_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# ── การเชื่อมต่อฐานข้อมูล PostgreSQL ───────────────
DATABASE_URL=postgresql://postgres:รหัสผ่านของคุณ@localhost:5432/minecraft_panel?schema=public

# ── ระบบยืนยันตัวตน (Auth.js & Discord OAuth2) ───
AUTH_SECRET=คีย์สุ่มความปลอดภัย_สร้างด้วย_openssl_rand_base64_32
AUTH_DISCORD_ID=ไอดีแอปพลิเคชัน_discord_client_id
AUTH_DISCORD_SECRET=ความลับแอปพลิเคชัน_discord_client_secret
AUTH_TRUST_HOST=true

# ── คีย์เข้ารหัสข้อมูลลับ (สำหรับรหัสผ่าน RCON และ Webhook) ──
ENCRYPTION_KEY=คีย์สุ่มความปลอดภัย_32_ไบต์_hex

# ── ค่าเริ่มต้นของ Minecraft Server บน Windows ───
MC_SERVERS_BASE_PATH=C:\MinecraftServers
MC_DEFAULT_JAVA_PATH=java

# ── ระดับการบันทึก Log ───────────────────────────
LOG_LEVEL=info

# ── ระบบจำกัดความถี่การยิงคำขอ (Rate Limiting) ────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── ระบบสำรองข้อมูล (Backup) ─────────────────────
BACKUP_BASE_PATH=C:\MinecraftBackups
BACKUP_MAX_SIZE_GB=50

# ── โซนเวลา ──────────────────────────────────────
TZ=Asia/Bangkok
