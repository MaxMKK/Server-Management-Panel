# ==========================================
# ไฟล์แม่แบบตัวแปรสภาพแวดล้อม (Environment Variables)
# ==========================================
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกข้อมูลจริงของเครื่องคุณ

# ── การตั้งค่าระบบแอปพลิเคชัน ─────────────────────
NODE_ENV=development
APP_PORT=4000
APP_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# ── การเชื่อมต่อฐานข้อมูล SQLite ──────────────────
# ใช้ไฟล์ฐานข้อมูล dev.db ภายในโฟลเดอร์ packages/database/prisma/
DATABASE_URL="file:./dev.db"

# ── ระบบยืนยันตัวตน (Auth & JWT) ────────────────
AUTH_SECRET=mc_panel_super_secret_jwt_key_2026_change_in_production
AUTH_DISCORD_ID=your_discord_client_id
AUTH_DISCORD_SECRET=your_discord_client_secret
AUTH_TRUST_HOST=true

# ── คีย์เข้ารหัสข้อมูลลับ (สำหรับรหัสผ่าน RCON และ Webhook) ──
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── ค่าเริ่มต้นของ Minecraft Server บน Windows ───
MC_SERVERS_BASE_PATH=C:\MinecraftServers
MC_DEFAULT_JAVA_PATH=java

# ── ระดับการบันทึก Log ───────────────────────────
LOG_LEVEL=info

# ── ระบบจำกัดความถี่การยิงคำขอ (Rate Limiting) ────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── ระบบสำรองข้อมูล (Backup) ─────────────────────
BACKUP_BASE_PATH=C:\MinecraftBackups
BACKUP_MAX_SIZE_GB=50

# ── โซนเวลา ──────────────────────────────────────
TZ=Asia/Bangkok
