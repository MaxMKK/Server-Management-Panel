// โครงสร้างฐานข้อมูลสำหรับระบบควบคุมเซิร์ฟเวอร์ Minecraft (Prisma Schema)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ใน Phase 2 ระบบจะเพิ่มตารางเหล่านี้:
//   - User (ข้อมูลผู้ใช้)
//   - Role (ระดับบทบาท: เจ้าของ, ผู้ดูแล, ผู้ใช้ทั่วไป)
//   - Permission (สิทธิ์รายข้อ)
//   - RolePermission (ตารางเชื่อมโยงสิทธิ์)
//   - Session (ประวัติการล็อกอิน)
//   - Server (ข้อมูลเซิร์ฟเวอร์ Minecraft แต่ละตัว)
//   - ServerBackup (ประวัติไฟล์สำรองข้อมูล)
//   - AuditLog (บันทึกกิจกรรมความปลอดภัยทุกขั้นตอน)
// ─────────────────────────────────────────────────────────────
